generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String @id @default(uuid())
  name        String
  email       String @unique
  password    String
  phoneNumber String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  actions       Action[]
  tasks         Task[]
  journals      Journal[]
  weeklyPlans   WeeklyPlan[]

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Action {
  id         String @id @default(uuid())
  userId     String
  actionName String

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id String @id @default(uuid())

  userId   String
  actionId String?

  title String
  time  String?

  completed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action Action? @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([actionId])
}

model Journal {
  id                String @id @default(uuid())
  userId            String
  summary           String
  productivityScore Int?

  completedTasks Int
  pendingTasks   Int

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WeeklyPlan {
  id        String @id @default(uuid())
  userId    String
  weekStart String

  weeklyTasks WeeklyTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
}

model WeeklyTask {
  id           String @id @default(uuid())
  weeklyPlanId String
  title        String
  day          String
  priority     String @default("MEDIUM")
  category     String
  duration     Int    @default(60)

  completed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeklyPlan WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)

  @@index([weeklyPlanId])
  @@index([day])
}
